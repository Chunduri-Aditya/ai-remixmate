# Copy to /etc/remixmate.env and chmod 600. Fill every placeholder.
# Do NOT commit a filled copy.

# --- auth ---
REMIXMATE_AUTH_ENABLED=true
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_AUD=authenticated
# SUPABASE_COOKIE_NAME=sb-access-token
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=  # optional; enables DELETE /account Supabase user purge
ADMIN_EMAILS=you@example.com

# --- database ---
DATABASE_URL=postgresql+psycopg://remixmate:PASSWORD@127.0.0.1:5432/remixmate

# --- paths / flags ---
LIBRARY_DIR=/mnt/catalog
# outputs stay on the VPS disk under the project tree by default
REMIXMATE_LICENSE_ENFORCE=true
REMIXMATE_SPECTRAL_LEARNING=false
# leave unset in prod:
# REMIXMATE_STEM_SPLIT_ENABLED=
# REMIXMATE_GENERATIVE_ENABLED=

# --- CORS / frontend ---
REMIXMATE_FRONTEND_URL=https://YOUR_DOMAIN
# Optional comma-separated override (takes precedence over FRONTEND_URL):
# REMIXMATE_CORS_ORIGINS=https://YOUR_DOMAIN

# --- Spotify (optional) ---
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# --- DMCA email (optional; intake still stores a row when unset) ---
# REMIXMATE_SMTP_HOST=
# REMIXMATE_SMTP_PORT=587
# REMIXMATE_SMTP_USER=
# REMIXMATE_SMTP_PASSWORD=
# REMIXMATE_SMTP_FROM=
# REMIXMATE_DMCA_CONTACT=you@example.com
