# Copy to /etc/remixmate.env and chmod 600. Fill every placeholder.
# Do NOT commit a filled copy.

# --- auth ---
REMIXMATE_AUTH_ENABLED=true
SUPABASE_JWKS_URL=https://YOUR_PROJECT.supabase.co/auth/v1/.well-known/jwks.json
# SUPABASE_JWT_AUD=authenticated
# optional; checks the token issuer when set
# SUPABASE_JWT_ISS=https://YOUR_PROJECT.supabase.co/auth/v1
# SUPABASE_COOKIE_NAME=sb-access-token
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=  # optional; enables DELETE /account Supabase user purge
ADMIN_EMAILS=you@example.com
# leave unset in prod; "1" skips the admin email_verified check:
# ADMIN_ALLOW_UNVERIFIED=

# --- database ---
DATABASE_URL=postgresql+psycopg://remixmate:PASSWORD@127.0.0.1:5432/remixmate

# --- paths / flags ---
# REMIXMATE_LIBRARY_LIBRARY_DIR / REMIXMATE_LIBRARY_OUTPUTS_DIR, when set, win over these aliases:
# REMIXMATE_LIBRARY_LIBRARY_DIR=
# REMIXMATE_LIBRARY_OUTPUTS_DIR=
REMIXMATE_LIBRARY_DIR=/mnt/catalog
# outputs stay on the VPS disk under the project tree by default:
# REMIXMATE_OUTPUTS_DIR=
# db and JSON state stay under the project tree by default:
# REMIXMATE_DATA_DIR=
# lyrics cache (remixmate.service sets /var/cache/remixmate/lyrics; set here only to override):
# REMIXMATE_CACHE_DIR=
# ingest only (download.py, curate_catalog.py) gates on this; the API only reports it:
REMIXMATE_LICENSE_ENFORCE=true
REMIXMATE_SPECTRAL_LEARNING=false
# behind Caddy: rate limit on the last X-Forwarded-For entry
REMIXMATE_TRUST_PROXY=1
# /health/ready returns 503 while the catalog is empty
REMIXMATE_REQUIRE_CATALOG=1
# force cpu, cuda or mps; autodetect when unset:
# REMIXMATE_DEVICE=cpu
# opt in MusicBrainz metadata lookups:
# REMIXMATE_MUSICBRAINZ_ENABLED=1
# REMIXMATE_LOG_LEVEL=INFO
# REMIXMATE_LOG_JSON=1
# leave unset in prod:
# REMIXMATE_STEM_SPLIT_ENABLED=
# REMIXMATE_GENERATIVE_ENABLED=

# --- CORS / frontend ---
REMIXMATE_FRONTEND_URL=https://YOUR_DOMAIN
# Optional comma-separated override (takes precedence over FRONTEND_URL):
# REMIXMATE_CORS_ORIGINS=https://YOUR_DOMAIN
# UI port the local dev CORS origins follow (default 5173); start.sh passes it to the API as RMX_UI_PORT.
# Not needed behind a reverse proxy where REMIXMATE_CORS_ORIGINS or REMIXMATE_FRONTEND_URL is set.
# REMIXMATE_UI_PORT=5173
# Frontend build var, set in Cloudflare Pages (not read by the API); lets the
# SSE cookie reach api.YOUR_DOMAIN:
# VITE_COOKIE_DOMAIN=YOUR_DOMAIN

# --- Spotify (optional) ---
# SPOTIFY_CLIENT_ID=
# SPOTIFY_CLIENT_SECRET=

# --- Genius (optional; wordplay bonus in setlists) ---
# GENIUS_TOKEN=

# --- DMCA email (optional; intake still stores a row when unset) ---
# REMIXMATE_SMTP_HOST=
# REMIXMATE_SMTP_PORT=587
# REMIXMATE_SMTP_USER=
# REMIXMATE_SMTP_PASSWORD=
# REMIXMATE_SMTP_FROM=
# REMIXMATE_DMCA_CONTACT=you@example.com
# fallback recipient when REMIXMATE_DMCA_CONTACT is unset:
# REMIXMATE_SMTP_TO=
