[Unit]
Description=AI RemixMate API
Wants=network-online.target
After=network-online.target
RequiresMountsFor=/mnt/catalog

[Service]
Type=simple
User=remixmate
Group=remixmate
WorkingDirectory=/opt/remixmate
EnvironmentFile=/etc/remixmate.env
ExecStart=/opt/remixmate/.venv/bin/uvicorn scripts.api.main:app --host 127.0.0.1 --port 8000 --workers 1 --timeout-graceful-shutdown 30
# Lifespan already calls _executor.shutdown(wait=True); give in-flight mixes time to finish.
TimeoutStopSec=600
Restart=on-failure
RestartSec=5
# Harden a bit — catalog volume should be mounted read-only separately.
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ReadWritePaths=/opt/remixmate/data /opt/remixmate/outputs
# HOME (/opt/remixmate) and site-packages are read only; librosa's numba cache=True
# JIT raises "no locator available" without a writable cache dir. CacheDirectory=
# creates /var/cache/remixmate owned by remixmate and writable under ProtectSystem=strict.
CacheDirectory=remixmate
Environment=NUMBA_CACHE_DIR=/var/cache/remixmate/numba
Environment=XDG_CACHE_HOME=/var/cache/remixmate
Environment=REMIXMATE_CACHE_DIR=/var/cache/remixmate/lyrics

[Install]
WantedBy=multi-user.target
